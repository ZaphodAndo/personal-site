---
permalink: /feed/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:base="{{ meta.language }}">
	<title>{{ meta.title }}</title>
	<subtitle>{{ meta.description }}</subtitle>
	<link href="{{ permalink | htmlBaseUrl(meta.url) }}" rel="self"/>
	<link href="{{ meta.url | addPathPrefixToFullUrl }}"/>
	<updated>{{ collections.post | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
	<id>{{ meta.url }}</id>
	<author>
		<name>{{ meta.author.name }}</name>
	</author>
	{%- for post in collections.post | reverse %}
	{% set absolutePostUrl %}{{ post.url | htmlBaseUrl(meta.url) }}{% endset %}
	<entry>
		<title>{{ post.data.title }}</title>
		<link href="{{ absolutePostUrl }}"/>
		<updated>{{ post.date | dateToRfc3339 }}</updated>
		<id>{{ absolutePostUrl }}</id>
		<content type="html">{{ post.content | renderTransforms(post.data.page, metadata.url) }}</content>
	</entry>
	{%- endfor %}
</feed>
